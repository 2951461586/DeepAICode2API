# DeepAICode2API 配置（复制为 .env 后填写）
#
# 网关启动时自动加载本文件；真实环境变量优先于 .env。

# ── 2API 网关 ─────────────────────────────────────────────────────
# 监听地址与端口（默认 127.0.0.1:10087）。非回环监听必须同时配管理口令。
DEEPAI2API_HOST=
DEEPAI2API_PORT=
# 管理口令（控制台与 /admin/* 接口）。留空 = 不鉴权（仅回环允许）。
DEEPAI2API_ADMIN_PASSWORD=

# ── 路径（留空自动探测）───────────────────────────────────────────
# 状态文件（账号 / 密钥 / 设置）。不填时：可执行文件同目录已有旧文件就用它，
# 否则用 %AppData% / ~/.config（避免落在共享目录）。
DEEPAI2API_DATA_PATH=
# DeepAI Code 桌面端数据目录（导入凭据用）；不填则读 T3CODE_HOME / ~/.deepai-code。
DEEPAI2API_DATA_DIR=
# .env 文件位置（默认按可执行文件同目录 / 当前目录的顺序找）。
DEEPAI2API_ENV_FILE=

# ── 上游地址与手工密钥（可选）────────────────────────────────────
# 仅接受 http/https；默认 https://api.deepai.org。
DEEPAI_API_ORIGIN=
# 不用桌面端时直接给一把上游 Key（入池为 source=env，名字用于展示）。
DEEPAI_API_KEY=
DEEPAI_API_KEY_NAME=

# ── 容器 / 无 SMBIOS 环境必填 ─────────────────────────────────────
# 上游所有模型请求都要求 X-DeepAI-Code-Machine；填桌面端所在机器的原始 UUID。
DEEPAI_MACHINE_ID=
# 桌面端数据目录的覆盖变量，仅当自动探测失败时才需要（T3CODE_HOME 优先）。
T3CODE_HOME=
DEEPAI_CODE_HOME=

# ── 代理池（按账号轮询分配）────────────────────────────────────────
# 完整 URL，逗号或换行分隔。浏览器登录入池时自动分配；存量账号用
# POST /admin/api/accounts {"action":"assign-proxy"} 补绑。
PROXY_POOL=
# 或从文件读取（每行一个）
PROXY_POOL_FILE=
# 兼容别名：DEEPAI_REGISTER_PROXY_POOL 仍被识别（注册链路时期的命名），
# 新配置一律用 PROXY_POOL。

# ── 安全默认值 ────────────────────────────────────────────────────
# 监听非回环地址（0.0.0.0 / 局域网 IP）时必须设置 DEEPAI2API_ADMIN_PASSWORD，
# 否则进程拒绝启动。确实要无密码运行才置 1（会把控制台暴露给整个网段）。
DEEPAI2API_ALLOW_INSECURE=

# ── 状态文件加密 ──────────────────────────────────────────────────
# 32 字节密钥，hex 或 base64；留空则状态文件以明文 JSON 落盘（会打警告）。
# 生成：openssl rand -hex 32；配置后先停网关，再跑一次
#   deepaicode2api -seal -yes
# 把存量主文件、统计与历史日志行一并封存。
DEEPAI2API_MASTER_KEY=
